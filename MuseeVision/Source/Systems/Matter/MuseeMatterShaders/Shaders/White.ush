// White: the face of a lime or gypsum body, the museum's white family (lime plaster, cast plaster, limewash).
//
// A plaster or a limewash is a fine aggregate bound by the crystals that grow as it sets: calcite as lime carbonates,
// gypsum as plaster of Paris rehydrates. Unlike a sedimentary stone it has no bedding; its structure is the same in
// every direction, from its finest aggregate up to the widest reach of the tool that laid it (a trowel's pass, a brush's
// stroke, a mould's face). Its face is still self-affine over those scales, so it is drawn with the stone's octaves, in
// axes with no preferred direction. Every number comes from the substance's and the working's records.

#pragma once

#include "/Project/Matter/Frame.ush"
#include "/Project/Matter/Stone.ush"

// Structure as fine in one direction as in any other: an unbedded body.
static const float MatterUnbedded = 1.0;

/** The face of a white body at PieceMeters: its tone, its roughness and the gradient of its relief, varied over the
 *  scales of its structure (Structure.GrainMillimeters is its finest aggregate, Structure.BedMillimeters the reach of
 *  the tool that laid it; BedAspect is ignored, since the body has no bedding). */
FMatterStoneFace MatterWhiteFace(float3 PieceMeters, float Seed, FMatterStone Structure, float Roughness)
{
	Structure.BedAspect = MatterUnbedded;
	return MatterStoneFace(PieceMeters, MatterNaturalBed(), Seed, Structure, Roughness);
}
