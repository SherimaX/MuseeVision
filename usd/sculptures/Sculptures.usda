#usda 1.0
(
    defaultPrim = "Museum"
    doc = "Musée Vision: the sculpture scans in place (geometry in the <id>.usdc files beside this one)."
    metersPerUnit = 1
    upAxis = "Y"
)

over "Museum"
{
    over "Salon"
    {
        def Mesh "degas_little_dancer" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            prepend references = @./degas-little-dancer.usdc@
            customData = {
                dictionary museevision = {
                    string workId = "degas-little-dancer"
                    string scanFile = "assets/sculptures/degas-little-dancer.mvm"
                    string work = "Edgar Degas, Little Dancer Aged Fourteen"
                    string scanSource = "passivactivist (Sketchfab), via Objaverse mirror (000-000)"
                    string scanSourcePage = "https://sketchfab.com/3d-models/863f2eb0ec4c44d7bb33091a58a12560"
                    string scanLicence = "CC BY 4.0"
                    string scanTriangles = "401,610 → 39,772"
                }
            }
        )
        {
            float3 xformOp:translate = (-34.5, 1, 3.4)
            quatf xformOp:orient = (0.70710677, 0, 0.70710677, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            custom string museevision:entity = "degas-little-dancer"
            uniform bool doubleSided = 1
            custom string museevision:workId = "degas-little-dancer"
            custom string museevision:scanFile = "assets/sculptures/degas-little-dancer.mvm"
            custom string museevision:work = "Edgar Degas, Little Dancer Aged Fourteen"
