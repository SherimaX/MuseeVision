        def Material "brass_mesh"
        {
            token outputs:surface.connect = </Museum/Materials/brass_mesh/Surface.outputs:surface>
            custom string museevision:source = "PhysicallyBasedMaterial"
            custom string museevision:tint = "#FFFFFF"

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Museum/Materials/brass_mesh/Image.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness = 0.6
                float inputs:metallic = 0.3
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Image"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/brass_mesh.png@
                float2 inputs:st.connect = </Museum/Materials/brass_mesh/UV.outputs:result>
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (1, 1, 1, 1)
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:a
                float3 outputs:rgb
            }
        }

