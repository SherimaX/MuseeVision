#usda 1.0
(
    defaultPrim = "Museum"
    doc = "Musée Vision: one UsdPreviewSurface material per distinct material of the Swift build. Names are stable across re-exports."
    metersPerUnit = 1
    upAxis = "Y"
)

over "Museum"
{
    def Scope "Materials"
    {
        def Material "bamboo"
        {
            token outputs:surface.connect = </Museum/Materials/bamboo/Surface.outputs:surface>
            custom string museevision:source = "PhysicallyBasedMaterial"
            custom string museevision:tint = "#5E7456"

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1119, 0.1746, 0.0931)
                float inputs:opacity = 1
                float inputs:roughness = 0.6
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "bark_birch"
        {
            token outputs:surface.connect = </Museum/Materials/bark_birch/Surface.outputs:surface>
            custom string museevision:source = "PhysicallyBasedMaterial"
            custom string museevision:tint = "#D8D2C4"

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6867, 0.6445, 0.552)
                float inputs:opacity = 1
                float inputs:roughness = 0.9
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "bark_brown"
        {
            token outputs:surface.connect = </Museum/Materials/bark_brown/Surface.outputs:surface>
